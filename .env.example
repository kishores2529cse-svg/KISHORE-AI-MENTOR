okay before # Environment Configuration for KISHORE S AI Mentor
# Copy to .env and configure your keys

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1. OpenRouter Configuration (Supports Grok, Gemini, Claude, DeepSeek, Llama)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. Grok / xAI Direct Configuration
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# 3. OmniRoute Configuration
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=grok-2

# 4. Google Gemini Configuration (Free tier supported)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-3.7-flash

# Features
ENABLE_FALLBACK_SIMULATION=true
SPEECH_ENGINE=web_speech
DATABASE_URL=sqlite:///./kishore_ai_mentor.db
